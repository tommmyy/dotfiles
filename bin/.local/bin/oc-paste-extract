#!/usr/bin/env python3
"""Extract images pasted into an opencode session to real files on disk.

opencode v2 stores a pasted image inline in the user message row
(`session_message.data -> $.files[]`, raw base64 in `data`), in the database
named by $OPENCODE_DB (default opencode-v2.db) under ~/.local/share/opencode.
The v1 database (opencode.db, `part` rows holding `data:` URLs) is no longer
written but is still read, so pastes from before the migration stay reachable.

A model cannot reproduce those bytes from what it sees — a vision input is a
decoded rendering, not the file — so anything that needs the actual image
(uploading a screenshot to a Linear issue, say) has to read them back out of
the database mechanically. That is all this does.

    oc-paste-extract --list          # what pastes are available
    oc-paste-extract                 # newest paste -> temp file
    oc-paste-extract -n 2 -o bug.png # 2nd newest -> bug.png

Prints path, dimensions, byte count and sha256. The sha256 is what
Linear's prepare_attachment_upload verifies against, so pass it through
rather than recomputing it somewhere else.
"""

from __future__ import annotations

import argparse
import base64
import datetime
import binascii
import hashlib
import json
import os
import pathlib
import sqlite3
import struct
import sys

DATA = pathlib.Path.home() / ".local/share/opencode"
LEGACY_DB = DATA / "opencode.db"
EXT = {
    "image/png": ".png",
    "image/jpeg": ".jpg",
    "image/webp": ".webp",
    "image/gif": ".gif",
}


def die(msg: str) -> "None":
    print(f"oc-paste-extract: {msg}", file=sys.stderr)
    raise SystemExit(1)


def when(ms: "int | None") -> str:
    """`time_created` is epoch milliseconds; show it in local time."""
    if not ms:
        return "?"
    return datetime.datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M")


def dimensions(data: bytes, mime: str) -> str:
    """Best-effort WxH. Only PNG is parsed; anything else reports unknown."""
    if mime == "image/png" and len(data) >= 24 and data[12:16] == b"IHDR":
        w, h = struct.unpack(">II", data[16:24])
        return f"{w}x{h}"
    return "?"


def active_db() -> pathlib.Path:
    """The database opencode is writing to now.

    opencode exports OPENCODE_DB (a file name relative to its data dir, or an
    absolute path) to the shells it spawns.
    """
    name = os.environ.get("OPENCODE_DB")
    if name:
        path = pathlib.Path(name).expanduser()
        return path if path.is_absolute() else DATA / path
    v2 = DATA / "opencode-v2.db"
    return v2 if v2.exists() else LEGACY_DB


def connect(db: pathlib.Path) -> sqlite3.Connection:
    # Read-only: opencode is normally running and holding this database open.
    return sqlite3.connect(f"file:{db}?mode=ro", uri=True)


def schema(con: sqlite3.Connection) -> "str | None":
    tables = {r[0] for r in con.execute(
        "select name from sqlite_master where type = 'table'")}
    # v1 databases also carry a (differently shaped) session_message table,
    # so `part` is the distinguishing one.
    if "part" in tables:
        return "v1"
    if "session_message" in tables:
        return "v2"
    return None


def current_session(con: sqlite3.Connection, kind: str) -> "str | None":
    """The session this command was invoked from.

    opencode exposes no session id to bash, and a session's directory is a
    project, not a job — hundreds of sessions can share one directory, so
    filtering on it barely narrows anything in a main checkout.

    Invoking a tool writes the caller's message row before the command runs,
    so the newest row in the database belongs to the caller.
    """
    table = "session_message" if kind == "v2" else "part"
    row = con.execute(
        f"select session_id from {table} order by time_created desc limit 1"
    ).fetchone()
    return row[0] if row else None


def decode(b64: str) -> "bytes | None":
    if b64.startswith("data:"):
        if "," not in b64:
            return None
        b64 = b64.split(",", 1)[1]
    try:
        return base64.b64decode(b64, validate=True) or None
    except (binascii.Error, ValueError):
        return None


def rows_v2(con, scope, cap) -> list[dict]:
    # Each user message carries its attachments in `$.files`; a paste is an
    # inline image there with raw base64 in `data`.
    sql = (
        "select m.session_id, m.time_created, f.value"
        " from session_message m, json_each(m.data, '$.files') f"
        " where m.type = 'user'"
        " and json_extract(f.value, '$.mime') like 'image/%'"
    )
    args: list = []
    if scope is not None:
        sql += " and m.session_id = ?"
        args.append(scope)
    sql += " order by m.time_created desc, f.key desc limit ?"
    args.append(cap)
    out = []
    for session_id, created, raw in con.execute(sql, args):
        try:
            f = json.loads(raw)
        except json.JSONDecodeError:
            continue
        data = decode(f.get("data") or f.get("url") or "")
        if data:
            out.append({"filename": f.get("name") or "paste",
                        "mime": f.get("mime", ""), "data": data,
                        "session": session_id or "", "created": created})
    return out


def rows_v1(con, scope, cap) -> list[dict]:
    # session_id / time_created are columns, not fields inside `data`.
    sql = (
        "select data, session_id, time_created from part"
        " where data like '%\"type\":\"file\"%' and data like '%image/%'"
    )
    args: list = []
    if scope is not None:
        sql += " and session_id = ?"
        args.append(scope)
    sql += " order by time_created desc limit ?"
    args.append(cap)
    out = []
    for raw, session_id, created in con.execute(sql, args):
        try:
            part = json.loads(raw)
        except json.JSONDecodeError:
            continue
        mime = part.get("mime", "")
        if part.get("type") != "file" or not mime.startswith("image/"):
            continue
        url = part.get("url", "")
        data = decode(url) if url.startswith("data:") else None
        if data:
            out.append({"filename": part.get("filename") or "paste",
                        "mime": mime, "data": data,
                        "session": session_id or "", "created": created})
    return out


def pastes(limit: int, scope: "str | None") -> list[dict]:
    active = active_db()
    if not active.exists():
        die(f"no opencode database at {active}")
    dbs = [active] + ([LEGACY_DB] if LEGACY_DB.exists()
                      and LEGACY_DB != active else [])
    cap = max(limit * 8, 64)
    found: list[dict] = []
    for i, db in enumerate(dbs):
        con = connect(db)
        try:
            kind = schema(con)
            if kind is None:
                if i == 0:
                    die(f"unrecognised schema in {db} (opencode upgrade?)")
                continue
            # Restricting to one session stops a screenshot pasted into one
            # job from being handed to an agent in another. The caller is
            # always in the active database.
            if scope == "@current":
                scope = current_session(con, kind)
                if scope is None:
                    break
            reader = rows_v2 if kind == "v2" else rows_v1
            found += reader(con, scope, cap)
        except sqlite3.DatabaseError as exc:
            die(f"cannot read {db}: {exc}")
        finally:
            con.close()
    found.sort(key=lambda it: it["created"] or 0, reverse=True)
    return found[:limit]


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="oc-paste-extract",
        description="Extract images pasted into opencode to files on disk.",
    )
    ap.add_argument("-n", "--index", type=int, default=1, metavar="N",
                    help="which paste, 1 = most recent (default: 1)")
    ap.add_argument("-o", "--out", metavar="PATH",
                    help="write here (default: a file in $TMPDIR)")
    ap.add_argument("-l", "--list", action="store_true",
                    help="list recent pastes without writing anything")
    ap.add_argument("-a", "--any", action="store_true",
                    help="search every session, not just this one")
    args = ap.parse_args()

    scope = None if args.any else "@current"

    if args.index < 1:
        die("--index is 1-based; 1 is the most recent paste")

    items = pastes(20 if args.list else args.index, scope)

    if args.list:
        if not items:
            where = "in this session" if scope else "at all"
            print(f"no pasted images found {where}"
                  + ("" if args.any else "; retry with --any"))
            return 0
        for i, it in enumerate(items, 1):
            print(f"{i:>2}. {when(it['created']):<17} {it['mime']:<11}"
                  f" {dimensions(it['data'], it['mime']):>10}"
                  f" {len(it['data']):>9} B  {it['session']}")
        return 0

    if len(items) < args.index:
        die(f"only {len(items)} pasted image(s) "
            + ("in this session" if scope else "available")
            + f", asked for #{args.index}"
            + ("" if args.any else "; retry with --any to search every session"))

    item = items[args.index - 1]
    if args.out:
        out = pathlib.Path(args.out).expanduser()
    else:
        tmp = pathlib.Path(os.environ.get("TMPDIR", "/tmp"))
        stem = pathlib.Path(item["filename"]).stem or "paste"
        out = tmp / f"oc-paste-{stem}{EXT.get(item['mime'], '.bin')}"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(item["data"])

    print(f"path   : {out}")
    print(f"mime   : {item['mime']}")
    print(f"dims   : {dimensions(item['data'], item['mime'])}")
    print(f"bytes  : {len(item['data'])}")
    print(f"sha256 : {hashlib.sha256(item['data']).hexdigest()}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
