{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "keybinds": {
    "session.page.up": "ctrl+alt+u",
    "session.page.down": "ctrl+alt+d",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "agent.cycle": "tab"
  },
  "plugins": [
    "./tui/workmux-status.ts",
    {
      "package": "opencode-vim",
      "options": {
        "vim": {
          "keymaps": {
            "normal": {
              "_": "^",
              "<Tab>": "command:agent.cycle"
            },
            "visual": {
              "_": "^"
            },
            "visual-line": {
              "_": "^"
            }
          }
        }
      }
    }
  ],
  "diffs": {
    "wrap": "word",
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
