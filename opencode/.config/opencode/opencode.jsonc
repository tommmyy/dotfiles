{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-5",
  "autoupdate": true,
  "agent": {
    "build": {
      "model": "anthropic/claude-opus-5-5",
    },
    "plan": {
      "model": "anthropic/claude-opus-5-5",
    },
  },
  "command": {
    "pr-done": {
      "template": "Create a summary for this PR and post it as a comment on the associated Linear task (from the branch name). Then mark the task as done. To identify the branch-only changes, use: - git log HEAD ^origin/develop --oneline to find commits unique to this branch - git show <commit> (or git diff <merge-base>..HEAD) for the actual diff - Do NOT use git diff origin/develop -- it includes unrelated changes when the branch is not rebased.",
      "description": "Summarize PR, comment on Linear task, mark task as done",
    },
    "refactor": {
      "template": "Scope: `$ARGUMENTS` (default to `worktree` if empty; the only other recognized value is `branch`). Goal: improve code quality WITHOUT changing external behavior -- better naming, structure, and readability; remove duplication and dead code; align with the conventions already used in the surrounding files (read them first, including any AGENTS.md/README). SELECTING THE DIFF: if scope is `worktree` (default), run `git add -A` first, then work from the staged diff (`git diff --cached`). If scope is `branch`, also consider the whole branch: `base=$(git merge-base HEAD origin/develop)`, then `git diff $base..HEAD` (never diff directly against `origin/develop` -- it pulls in unrelated changes when the branch is not rebased), then `git add -A`. Consider EVERY changed file type, not just JS/TS: JSX, SCSS/CSS, config/JSON5, templates, docs and tests all count. HUNT FOR DUPLICATION deliberately across the whole diff -- repeated literals, logic blocks, JSX, CSS declarations/selectors, or copy-pasted sibling files -- and remove it with the DRY tool the language offers (a shared function/constant for JS, a mixin/placeholder/variable for SCSS), even when the copies live in different scopes or files (you do NOT have to merge selectors to dedupe them). Do NOT bail out with 'already clean' when the diff under review introduced duplication; if you judge a duplicate to be intentional/idiomatic, say so explicitly and why. Respect anti-churn rules: no reformatting untouched code, no speculative abstractions (YAGNI -- every new helper/param needs >=2 real callers), keep the diff minimal and scoped. STEPS: 1) Read each in-scope file before editing. 2) Make focused, behavior-preserving edits only. 3) VERIFY: run the project's typecheck + lint + tests + build gates and report which you ran and their result; for a pure output transform (e.g. extracting an SCSS mixin) PROVE the built artifact is byte-identical by compiling and diffing, do not just assume it. 4) Leave all changes staged (`git add -A`); do NOT commit or push. Report a short summary of what was refactored, what you deliberately left as-is and why, and how you verified it.",
      "description": "Refactor worktree (default) or full branch for code quality; hunt duplication across all file types, verify gates, stage (no commit)",
      "agent": "build",
      "model": "anthropic/claude-opus-4-8",
      "variant": "high",
    },
  },
  // Anthropic auth comes from opencode-claude-auth-v2, which imports the Claude
  // Code credentials out of the macOS keychain — reconnect with
  // `opencode auth login anthropic --method claude-code` after a Claude Code
  // re-login. ChatGPT Pro/Plus OAuth is built in, so it needs no plugin.
  // Vim editing is a terminal-only plugin and lives in cli.json.
  "plugins": ["opencode-claude-auth-v2@latest"],
  "mcp": {
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote@0.2.5",
        "https://mcp.linear.app/mcp",
      ],
      "enabled": true,
      "timeout": 30000,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": false,
    },
    "claude-design": {
      "type": "local",
      "command": ["npx", "-y", "github:erdnj/claude-design-mcp"],
      "enabled": true,
    },
    // in Chrome: chrome://inspect/#remote-debugging
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        // need this if you want to debug in your chrome
        "--autoConnect",
        "--logFile",
        "/tmp/chrome-devtools-mcp.log",
        "--no-usage-statistics",
      ],
      "enabled": false,
    },
    // "slack": {
    //   "command": [
    //     "npx",
    //     "-y",
    //     "slack-mcp-server@latest",
    //     "--transport",
    //     "stdio",
    //   ],
    //   "type": "local",
    //   "environment": {
    //     // NOTE: set in zsh
    //     // "SLACK_MCP_XOXP_TOKEN": "${env:SLACK_MCP_XOXP_TOKEN}",
    //     "SLACK_MCP_ADD_MESSAGE_TOOL": "true",
    //     "SLACK_MCP_ENABLED_TOOLS": "conversations_history, conversations_replies, conversations_add_message, reactions_add, reactions_remove, attachment_get_data, conversations_search_messages, channels_list, usergroups_list, usergroups_me, usergroups_create, usergroups_update, usergroups_users_update",
    //   },
    // },
    // "shadcn-ui": {
    //   "type": "local",
    //   "command": ["npx", "-y", "@jpisnice/shadcn-ui-mcp-server"],
    //   "enabled": true,
    //   "timeout": 30000,
    // },
    // Default browser for agents: no window, fresh profile every run.
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
      ],
      "enabled": true,
      "timeout": 30000,
    },
    // Same tools, but in a visible Chrome window with the persistent profile —
    // pick this when the run needs watching or a logged-in session.
    "playwright-headed": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chrome"],
      "enabled": true,
      "timeout": 30000,
    },
    // Attaches to a Chrome already started with --remote-debugging-port=9222.
    "playwright-tenant": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://localhost:9222",
      ],
      "enabled": true,
      "timeout": 30000,
    },
    // Secrets live in the macOS keychain and are exported from ~/.zsh_secrets:
    //   idoklad-client-id, idoklad-client-secret  (Nastavení > Aplikace a API)
    //   idoklad-email, idoklad-password           (web login, VAT filings only)
    "idoklad": {
      "type": "local",
      "command": [
        "node",
        "/Users/tommmyy/.config/opencode/mcp/idoklad/index.js",
      ],
      "environment": {
        "IDOKLAD_CLIENT_ID": "{env:IDOKLAD_CLIENT_ID}",
        "IDOKLAD_CLIENT_SECRET": "{env:IDOKLAD_CLIENT_SECRET}",
        "IDOKLAD_EMAIL": "{env:IDOKLAD_EMAIL}",
        "IDOKLAD_PASSWORD": "{env:IDOKLAD_PASSWORD}",
      },
      // Off by default: invoicing and VAT filings come up a few times a month,
      // so the tools are not worth their context cost in every session.
      "enabled": false,
      // Generating VAT filings drives a browser, so allow more than the usual 30s.
      "timeout": 180000,
    },
    "prometheus": {
      "type": "local",
      "command": [
        "/Users/tommmyy/.local/share/opencode/venvs/prometheus-mcp/bin/prometheus-mcp-server",
      ],
      "environment": {
        "PROMETHEUS_URL": "{env:PROMETHEUS_URL}",
        "PROMETHEUS_USERNAME": "{env:PROMETHEUS_USERNAME}",
        "PROMETHEUS_PASSWORD": "{env:PROMETHEUS_PASSWORD}",
        "PROMETHEUS_MCP_SERVER_TRANSPORT": "stdio",
      },
      "enabled": true,
      "timeout": 30000,
    },
    // Read-only SQL access to the Perselio analytics DB via Superset SQL Lab.
    // Secret lives in the macOS keychain as `superset-sdp` and is exported from
    // ~/.zsh_secrets; the URL and service-account name are exported there too.
    //
    // The Superset connection this reaches has DML and CTAS enabled and runs as
    // the Postgres role that owns the analytics tables, so read-only is enforced
    // entirely by the server's own guard. See the server README before changing
    // anything in src/readonly.js.
    "superset": {
      "type": "local",
      "command": [
        "node",
        "/Users/tommmyy/.config/opencode/mcp/superset/index.js",
      ],
      "environment": {
        "SUPERSET_URL": "{env:SUPERSET_URL}",
        "SUPERSET_USER": "{env:SUPERSET_USER}",
        "SUPERSET_PASSWORD": "{env:SUPERSET_PASSWORD}",
      },
      // Off by default: analytics questions come up occasionally, so the tools
      // are not worth their context cost in every session.
      "enabled": false,
      // Aggregations over large tenants regularly run past a minute.
      "timeout": 300000,
    },
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 20000,
  },
  "provider": {
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": ["reasoning.encrypted_content"],
        "store": false,
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5 (OAuth)",
          "limit": {
            "context": 272000,
            "output": 128000,
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"],
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "medium",
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "detailed",
              "textVerbosity": "medium",
            },
          },
        },
      },
    },
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/workspaces/sdp/s-analytics/sources/private.plans/**": "allow",
      "~/worklog/**": "allow",
      "~/tmp/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/tmp/**": "allow",
      "{env:TMPDIR}/**": "allow",
    },
  },
}
